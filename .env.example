# Copy to .env.local and fill in. Real values are never committed.

# Firebase web app (public identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise site key (public). Leave empty to keep App Check off.
# Create it in Firebase console -> Build -> App Check -> Apps -> your web app -> reCAPTCHA Enterprise.
NEXT_PUBLIC_FIREBASE_APPCHECK_KEY=
# Optional, development only: a fixed debug token to register under App Check -> Manage debug tokens.
# If empty, the SDK generates one and prints it in the browser console.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Firebase Admin (server only). Without these, /api/session answers 503.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# CRM (/admin)
ADMIN_USER=
ADMIN_PASSWORD_HASH=   # node scripts/admin-hash.mjs "your password"
ADMIN_SESSION_SECRET=  # 32+ random characters
ADMIN_RECOVERY_KEY=    # 24+ random characters, kept by the owner, used on the forgot-password page

# Razorpay. Leave unset to keep the demo checkout. Use rzp_test_ keys first; a test key never counts as collected money in the CRM.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # the secret you set on the webhook (event payment.captured, URL /api/payments/webhook)
